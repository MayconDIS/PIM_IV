@startuml DER Nex_TI
' DER (Diagrama Entidade-Relacionamento) do Nex_TI: as tabelas do SQL Server com chaves
' primárias (PK) e estrangeiras (FK), o nome de cada relacionamento e a cardinalidade
' em pé de galinha. Fonte: sistema/apps/api/Data (migrations) e database/NexTI_DB.sql.
' Leitura: ||--o{ = um para muitos (o lado com o pé de galinha é o "muitos").
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 55
hide circle
hide methods

title DER — Nex_TI (tabelas, chaves e relacionamentos)

package "Estudo" {
  entity usuarios {
    * id : INT <<PK>>
    --
    * username : NVARCHAR(50) <<único>>
    * email : NVARCHAR(100) <<único>>
    * perfil : NVARCHAR(20)
    * senha_hash : NVARCHAR(255)
    * nivel : INT
    * xp : INT
    * moedas : INT
    * data_criacao : DATETIME2
  }
  entity fases {
    * codigo_fase : NVARCHAR(20) <<PK>>
    --
    * descricao : NVARCHAR(100)
  }
  entity flashcards {
    * id : INT <<PK>>
    --
    * codigo_fase : NVARCHAR(20) <<FK>>
    * frente : NVARCHAR(MAX)
    * verso : NVARCHAR(MAX)
    dica : NVARCHAR(255)
    opcoes : NVARCHAR(MAX)
    correta : INT
  }
  entity progresso_flashcards {
    * usuario_id : INT <<PK, FK>>
    * flashcard_id : INT <<PK, FK>>
    --
    * repeticoes : INT
    * intervalo_dias : FLOAT
    * fator_facilidade : FLOAT
    * data_proxima_revisao : DATETIME2
  }
  entity tb_historico_revisoes {
    * id_historico : INT <<PK>>
    --
    * usuario_id : INT <<FK>>
    * flashcard_id : INT <<FK>>
    * intervalo_dias : FLOAT
    * data_revisao : DATETIME2
  }
  entity cartas_moderadas {
    * id : INT <<PK>>
    --
    * codigo_fase : NVARCHAR(20)
    * frente : NVARCHAR(MAX)
    * data_moderacao : DATETIME2
  }
}

package "Simulados ENADE" {
  entity tb_areas_conhecimento {
    * id_area : INT <<PK>>
    --
    * nome_area : NVARCHAR(100)
  }
  entity tb_questoes {
    * id_questao : INT <<PK>>
    --
    * id_area : INT <<FK>>
    * enunciado : NVARCHAR(MAX)
    origem : NVARCHAR(50)
  }
  entity tb_alternativas {
    * id_alternativa : INT <<PK>>
    --
    * id_questao : INT <<FK>>
    * texto : NVARCHAR(MAX)
    * is_correta : BIT
  }
  entity tb_provas {
    * id_prova : INT <<PK>>
    --
    * ano : INT
    * tipo : NVARCHAR(50)
  }
  entity tb_prova_questao {
    * id_prova : INT <<PK, FK>>
    * id_questao : INT <<PK, FK>>
  }
}

usuarios ||--o{ progresso_flashcards : "estuda"
flashcards ||--o{ progresso_flashcards : "é estudada em"
fases ||--o{ flashcards : "contém"
usuarios ||--o{ tb_historico_revisoes : "gera"
flashcards ||--o{ tb_historico_revisoes : "aparece em"
fases ||..o{ cartas_moderadas : "lembra (sem FK)"

tb_areas_conhecimento ||--o{ tb_questoes : "classifica"
tb_questoes ||--|{ tb_alternativas : "tem"
tb_questoes ||--o{ tb_prova_questao : "aparece em"
tb_provas ||--o{ tb_prova_questao : "reúne"

legend right
  * = obrigatório (NOT NULL)
  ||--o{ = um para zero ou muitos
  ||--|{ = um para um ou muitos
  pontilhado = ligação lógica, sem chave estrangeira
endlegend
@enduml
