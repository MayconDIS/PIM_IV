@startuml Modelo Fisico Nex_TI
' Modelo físico do banco do Nex_TI no SQL Server / Azure SQL: tipos, chaves,
' índices e onde atuam os triggers. Fonte: database/NexTI_DB.sql.
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
hide circle
hide methods

title Modelo Físico — Nex_TI (SQL Server)

entity usuarios {
  * id : INT IDENTITY <<PK>>
  --
  * username : NVARCHAR(50) <<UNIQUE>>
  * email : NVARCHAR(100) <<UNIQUE>>
  * senha_hash : NVARCHAR(255)
  * nivel : INT
  * xp : INT
  * moedas : INT
  * data_criacao : DATETIME2
  ..
  trigger: tg_usuarios_protege_gamificacao
}

entity fases {
  * codigo_fase : NVARCHAR(20) <<PK>>
  --
  * descricao : NVARCHAR(100)
}

entity flashcards {
  * id : INT IDENTITY <<PK>>
  --
  * codigo_fase : NVARCHAR(20) <<FK>>
  * frente : NVARCHAR(MAX)
  * verso : NVARCHAR(MAX)
  dica : NVARCHAR(255)
  opcoes : NVARCHAR(MAX)
  correta : INT
}

entity progresso_flashcards {
  * usuario_id : INT <<PK, FK>>
  * flashcard_id : INT <<PK, FK>>
  --
  * repeticoes : INT
  * intervalo_dias : FLOAT
  * fator_facilidade : FLOAT
  * data_proxima_revisao : DATETIME2
  ..
  trigger: tg_progresso_historico
}

entity tb_historico_revisoes {
  * id_historico : INT IDENTITY <<PK>>
  --
  * usuario_id : INT <<FK>>
  * flashcard_id : INT <<FK>>
  * repeticoes : INT
  * intervalo_dias : FLOAT
  * fator_facilidade : FLOAT
  * data_proxima_revisao : DATETIME2
  * data_revisao : DATETIME2 = SYSUTCDATETIME()
  ..
  índice: (usuario_id, data_revisao)
}

entity tb_areas_conhecimento {
  * id_area : INT IDENTITY <<PK>>
  --
  * nome_area : NVARCHAR(100)
}

entity tb_questoes {
  * id_questao : INT IDENTITY <<PK>>
  --
  * id_area : INT <<FK>>
  * enunciado : NVARCHAR(MAX)
  origem : NVARCHAR(50)
}

entity tb_alternativas {
  * id_alternativa : INT IDENTITY <<PK>>
  --
  * id_questao : INT <<FK>>
  * texto : NVARCHAR(MAX)
  * is_correta : BIT
}

entity tb_provas {
  * id_prova : INT IDENTITY <<PK>>
  --
  * ano : INT
  * tipo : NVARCHAR(50)
}

entity tb_prova_questao {
  * id_prova : INT <<PK, FK>>
  * id_questao : INT <<PK, FK>>
}

fases ||--o{ flashcards
usuarios ||--o{ progresso_flashcards
flashcards ||--o{ progresso_flashcards
usuarios ||--o{ tb_historico_revisoes
flashcards ||--o{ tb_historico_revisoes
tb_areas_conhecimento ||--o{ tb_questoes
tb_questoes ||--o{ tb_alternativas
tb_provas ||--o{ tb_prova_questao
tb_questoes ||--o{ tb_prova_questao

legend right
  Todas as FKs usam ON DELETE CASCADE.
  Funções: fn_nivel_por_xp, fn_cartas_devidas
  Views: vw_ranking_alunos, vw_desempenho_por_fase
  Procedures: sp_ranking_alunos, sp_estatisticas_aluno,
  sp_cadastrar_flashcard, sp_historico_revisoes
endlegend
@enduml
