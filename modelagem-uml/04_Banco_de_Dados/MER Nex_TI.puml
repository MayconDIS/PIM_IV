@startchen MER Nex_TI
' MER (modelo conceitual) do banco do Nex_TI — notação de Chen.
' Fonte: sistema/apps/api/Data (migrations InicialAzureSql e ObjetosDoBanco).
' CARTA_MODERADA: carta que um Tutor editou ou excluiu (ligada à fase só pelo código, sem FK).

entity USUARIO {
  Id <<key>>
  Username
  Email
  SenhaHash
  Perfil
  XP
  Moedas
  Nivel
  DataCriacao
}

entity FASE {
  CodigoFase <<key>>
  Descricao
}

entity FLASHCARD {
  Id <<key>>
  Frente
  Verso
  Dica
}

entity CARTA_MODERADA {
  Id <<key>>
  Frente
  DataModeracao
}

entity HISTORICO_REVISAO {
  IdHistorico <<key>>
  DataRevisao
  IntervaloDias
  FatorFacilidade
}

entity AREA_CONHECIMENTO {
  IdArea <<key>>
  NomeArea
}

entity QUESTAO {
  IdQuestao <<key>>
  Enunciado
  Origem
}

entity ALTERNATIVA {
  IdAlternativa <<key>>
  Texto
  IsCorreta
}

entity PROVA {
  IdProva <<key>>
  Ano
  Tipo
}

relationship CONTEM {
}
relationship ESTUDA {
  Repeticoes
  IntervaloDias
  FatorFacilidade
  DataProximaRevisao
}
relationship LEMBRA {
}
relationship GERA {
}
relationship REFERE {
}
relationship CLASSIFICA {
}
relationship POSSUI {
}
relationship COMPOE {
}

FASE -1- CONTEM
CONTEM -N- FLASHCARD

FASE -1- LEMBRA
LEMBRA -N- CARTA_MODERADA

USUARIO -N- ESTUDA
ESTUDA -N- FLASHCARD

USUARIO -1- GERA
GERA -N- HISTORICO_REVISAO
FLASHCARD -1- REFERE
REFERE -N- HISTORICO_REVISAO

AREA_CONHECIMENTO -1- CLASSIFICA
CLASSIFICA -N- QUESTAO

QUESTAO -1- POSSUI
POSSUI -N- ALTERNATIVA

PROVA -N- COMPOE
COMPOE -N- QUESTAO
@endchen
