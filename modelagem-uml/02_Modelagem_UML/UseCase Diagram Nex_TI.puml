@startuml UseCase Diagram Nex_TI
' Diagrama de Casos de Uso do Nex_TI: os casos de uso de cada perfil, ligados ao código atual.
' Perfis em sistema/apps/api/Models/Perfis.cs.
' Sem 'monochrome': no servidor do PlantUML ele apaga os textos dos casos de uso e dos atores.
skinparam NoteBackgroundColor #F5F5F5
skinparam UsecaseBackgroundColor #F5F5F5
skinparam ActorBackgroundColor #F5F5F5
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 28
skinparam ranksep 90
left to right direction

title Diagrama de Casos de Uso — Nex_TI

actor "Usuário" as Usuario
actor Aluno
actor Tutor
actor Administrador
Aluno -|> Usuario
Tutor -|> Aluno
Administrador -|> Tutor

rectangle "Sistema Nex_TI (site, app e API)" {
  usecase "Cadastrar Novo Usuário" as UC_Cadastro
  usecase "Realizar Login" as UC_Login
  usecase "Ajustar Acessibilidade" as UC_A11y
  usecase "Gerenciar Minha Conta" as UC_Conta
  usecase "Estudar Flashcards" as UC_Estudar
  usecase "Realizar Teste de Nivelamento" as UC_Nivel
  usecase "Realizar Simulado ENADE" as UC_Enade
  usecase "Visualizar Painel de Desempenho" as UC_Painel
  usecase "Criar Flashcards" as UC_Criar
  usecase "Atribuir XP e Moedas" as UC_XP
  usecase "Desbloquear Fases e Módulos" as UC_Fases
  usecase "Estudar sem Internet (app)" as UC_Offline
  usecase "Acompanhar Desempenho\ndos Usuários" as UC_Acompanhar
  usecase "Gerenciar Conteúdo das Cartas" as UC_Conteudo
  usecase "Gerenciar Perfis e Acessos" as UC_Perfis
}

Usuario --> UC_Cadastro
Usuario --> UC_Login
Usuario --> UC_A11y
Usuario --> UC_Conta
Aluno --> UC_Estudar
Aluno --> UC_Nivel
Aluno --> UC_Enade
Aluno --> UC_Painel
Aluno --> UC_Criar
Tutor --> UC_Acompanhar
Tutor --> UC_Conteudo
Administrador --> UC_Perfis

UC_Estudar ..> UC_XP : <<include>>
UC_Enade ..> UC_XP : <<include>>
' Os casos que estendem ficam à direita do caso base (ligação invisível só para a
' posição) e o «extend» é desenhado com norank, sem mexer no layout. Assim os casos
' do Aluno ficam numa coluna só e as linhas dele saem retas.
UC_Estudar -[hidden]-> UC_Offline
UC_Estudar -[hidden]-> UC_Fases
UC_Offline .[norank].> UC_Estudar : <<extend>>
UC_Fases .[norank].> UC_Estudar : <<extend>>

note "Cada perfil herda o anterior:\nUsuário → Aluno → Tutor → Administrador.\nA API confere o perfil gravado no banco." as N1
@enduml
