@startuml Class Diagram Nex_TI - Camadas
' Diagrama de Classes — camadas da API (sistema/apps/api, NexTI_API, .NET 10)
' Lido de cima para baixo: Rotas → Serviços de aplicação → Serviços de apoio → Dados.
' As setas entre camadas resumem as dependências: cada rota usa a interface do serviço,
' e cada serviço usa o AppDbContext (a lista completa de rotas está no Manual Técnico).
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 45
hide empty members

title Diagrama de Classes 1/2 — NexTI_API: camadas e serviços

package "1. Rotas (Endpoints)" as Rotas {
  class EndpointExtensions <<static>> {
    + {static} MapNexTiEndpoints(app : IEndpointRouteBuilder) : void
    + {static} IdDoUsuario(usuario : ClaimsPrincipal) : int [0..1]
    + {static} ParaHttp<T>(resultado : Resultado<T>, ...) : IResult
  }
  class ContaEndpoints <<static>> {
    + {static} MapContaEndpoints(app : IEndpointRouteBuilder) : void
  }
  note right of ContaEndpoints
    24 rotas, por exemplo:
    POST /api/auth/login · POST /api/progresso/atualizar
    GET /api/tutor/alunos (Tutor, Admin)
    PUT /api/admin/usuarios/{id}/perfil (Admin)
    /api/conta (só o titular do token)
  end note
}

package "2. Serviços de aplicação (regras de negócio)" as Servicos {
  together {
    interface IAuthService {
      + CadastrarAsync(...) : Task<Resultado<Usuario>>
      + EntrarAsync(...) : Task<Resultado<Sessao>>
    }
    interface IProgressoService {
      + RegistrarRespostaAsync(...) : Task<ProgressoFlashcard>
      + EstatisticasAsync(username) : Task<Resultado<...>>
    }
    interface IGamificacaoService {
      + AtualizarAsync(...) : Task<Resultado<Usuario>>
      + ResumoAsync(tamanho) : Task<ResumoGeral>
    }
  }
  together {
    interface IConteudoService {
      + ListarFlashcardsAsync(codigoFase) : Task<List<Flashcard>>
      + EditarFlashcardAsync(...) : Task<Resultado<Flashcard>>
    }
    interface IAdminService {
      + PainelDosAlunosAsync() : Task<List<AlunoNoPainel>>
      + DefinirPerfilAsync(...) : Task<Resultado<UsuarioResumo>>
    }
    interface IContaService {
      + AlterarSenhaAsync(...) : Task<Resultado<bool>>
      + ExcluirAsync(...) : Task<Resultado<bool>>
    }
  }
  class AuthService
  class ProgressoService {
    + DiasParaCartaMadura : int = 21
  }
  class GamificacaoService {
    + IncrementoMaximo : int = 200
  }
  class ConteudoService
  class AdminService
  class ContaService

  class "Resultado<T>" as Resultado <<record>> {
    + Valor : T [0..1]
    + Falha : TipoFalha [0..1]
    + Mensagem : string
  }
  enum TipoFalha {
    Invalido
    NaoEncontrado
    NaoAutorizado
  }
}

package "3. Serviços de apoio" as Apoio {
  interface IPoliticaDeSenha {
    + Validar(senha, nickname, email) : IReadOnlyList<string>
  }
  class PoliticaDeSenha {
    + TamanhoMinimo : int = 8
    + TamanhoMaximo : int = 72
  }
  interface ISm2Engine {
    + Calcular(progresso, qualidade) : void
  }
  class Sm2Engine
  interface IEtapaSeed {
    + ExecutarAsync(db) : Task<int>
  }
  class DatabaseSeeder
  class ConteudoSeeder
  class SimuladoSeeder
}

package "4. Dados (persistência)" as Dados {
  class AppDbContext {
    + Usuarios : DbSet<Usuario>
    + Flashcards : DbSet<Flashcard>
    + Progresso_Flashcards : DbSet<ProgressoFlashcard>
    + Questoes : DbSet<Questao>
    + CartasModeradas : DbSet<CartaModerada>
  }
  class DbContext <<EF Core>>
  class ConexaoBanco <<static>> {
    + Resolver(config) : string
  }
}

' --- cada interface em cima da classe que a implementa ---
IAuthService <|.. AuthService
IProgressoService <|.. ProgressoService
IGamificacaoService <|.. GamificacaoService
IConteudoService <|.. ConteudoService
IAdminService <|.. AdminService
IContaService <|.. ContaService
Resultado --> TipoFalha

IPoliticaDeSenha <|.. PoliticaDeSenha
ISm2Engine <|.. Sm2Engine
IEtapaSeed <|.. ConteudoSeeder
IEtapaSeed <|.. SimuladoSeeder
DatabaseSeeder o-- "1..*" IEtapaSeed : executa >

DbContext <|-- AppDbContext
ConexaoBanco ..> AppDbContext : connection string

' --- dependências entre camadas (resumidas) ---
Rotas ..> Servicos : usa as interfaces\n(injeção de dependência)
AuthService ..> IPoliticaDeSenha
ContaService ..> IPoliticaDeSenha
ProgressoService ..> ISm2Engine
Servicos ..> Dados : usa o AppDbContext

' ordem vertical das camadas
Rotas -[hidden]down- Servicos
Servicos -[hidden]down- Apoio
Apoio -[hidden]down- Dados
@enduml
